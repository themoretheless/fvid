[
  {
    "label": "fvid play (current file)",
    "command": "cargo",
    "args": ["run", "--features", "media", "--", "play", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FVID_FFMPEG_PREFIX": "C:\\ffmpeg-shared",
      "LIBCLANG_PATH": "C:\\Program Files\\LLVM\\bin",
      "PATH": "C:\\ffmpeg-shared\\bin;${PATH}"
    },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "fvid play (selection / URL)",
    "command": "cargo",
    "args": ["run", "--features", "media", "--", "play", "$ZED_SELECTED_TEXT"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FVID_FFMPEG_PREFIX": "C:\\ffmpeg-shared",
      "LIBCLANG_PATH": "C:\\Program Files\\LLVM\\bin",
      "PATH": "C:\\ffmpeg-shared\\bin;${PATH}"
    },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "fvid play release (current file)",
    "command": "cargo",
    "args": [
      "run",
      "--release",
      "--features",
      "media",
      "--",
      "play",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FVID_FFMPEG_PREFIX": "C:\\ffmpeg-shared",
      "LIBCLANG_PATH": "C:\\Program Files\\LLVM\\bin",
      "PATH": "C:\\ffmpeg-shared\\bin;${PATH}"
    },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build fvid media",
    "command": "cargo",
    "args": ["build", "--features", "media"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "FVID_FFMPEG_PREFIX": "C:\\ffmpeg-shared",
      "LIBCLANG_PATH": "C:\\Program Files\\LLVM\\bin",
      "PATH": "C:\\ffmpeg-shared\\bin;${PATH}"
    },
    "reveal": "always",
    "hide": "on_success"
  }
]
