[
  {
    "label": "fvid player",
    "command": "cargo",
    "args": [
      "run",
      "--no-default-features",
      "--features",
      "player",
      "--",
      "play"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "fvid player (current Y4M file)",
    "command": "cargo",
    "args": [
      "run",
      "--no-default-features",
      "--features",
      "player",
      "--",
      "play",
      "$ZED_FILE"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "fvid player release",
    "command": "cargo",
    "args": [
      "run",
      "--release",
      "--no-default-features",
      "--features",
      "player",
      "--",
      "play"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "build fvid player",
    "command": "cargo",
    "args": [
      "build",
      "--no-default-features",
      "--features",
      "player"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]
