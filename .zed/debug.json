[
  {
    "label": "Debug fvid player",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": [
        "build",
        "--no-default-features",
        "--features",
        "player",
        "--bin",
        "fvid"
      ],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/fvid",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "play"
    ],
    "sourceLanguages": [
      "rust"
    ]
  },
  {
    "label": "Debug fvid player (current Y4M file)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": [
        "build",
        "--no-default-features",
        "--features",
        "player",
        "--bin",
        "fvid"
      ],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/fvid",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [
      "play",
      "$ZED_FILE"
    ],
    "sourceLanguages": [
      "rust"
    ]
  }
]
